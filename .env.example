# ═════════════════════════════════════════════════════════════════════════════════════════════
# FIRE 배포·운영 환경 변수 예시
#
# 사용법: cp .env.example .env 후 필요한 값만 채우십시오. .env는 .gitignore에 있어 커밋되지 않습니다.
#
# [1] 개인 키·시드 구문·키스토어 비밀번호는 이 파일과 .env에 절대 넣지 마십시오. 서명은 forge/cast 옵션으로만 합니다.
#       --ledger --sender <주소>     하드웨어 지갑 (메인넷 권장). 첫 계정이 아니면 파생 경로를 붙임:
#                                    forge script → --mnemonic-derivation-paths "m/44'/60'/<n>'/0/0" (복수형)
#                                                   또는 --mnemonic-indexes <n>
#                                    cast         → --mnemonic-derivation-path "m/44'/60'/<n>'/0/0" (단수형)
#                                    (forge script는 단수형을 거부함. 먼저 cast wallet address --ledger
#                                     --mnemonic-derivation-path "..."로 주소 확인)
#       --account <이름> --sender <주소>
#                                    cast wallet import <이름> --interactive 로 만든 암호화 키스토어
#                                    (~/.foundry/keystores, 비밀번호는 실행할 때 입력)
#     --private-key·--mnemonic·ETH_PASSWORD는 쓰지 마십시오 (셸 기록·프로세스 목록·파일에 남음).
#
# [2] forge는 프로젝트 루트의 .env를 모든 forge 명령(script·test·coverage)에서 자동으로 읽습니다.
#     셸에서 export한 값이 .env보다 우선합니다.
#       - BASE_RPC_URL·BASE_SEPOLIA_RPC_URL이 채워져 있으면 forge test가 포크 테스트(네트워크 접속)까지 실행합니다.
#       - CONFIRM_MAINNET은 .env에 넣지 마십시오 (맨 아래 6절).
#       - .env는 리허설(Base Sepolia)과 메인넷 실행 모두에 적용됩니다. 체인마다 다른 주소·서명은 .env에 고정하기보다
#         실행할 셸에서 export하거나 명령 앞에 붙이는 방식을 권장합니다 (오래된 값이 섞이는 사고 방지).
#
# [3] 빈 값(KEY=)은 모든 스크립트에서 "설정 안 함"과 같습니다 → 기본값 또는 deployments/<chainId>.json 기록값 사용.
#     예외: foundry.toml이 읽는 0절 변수는 비어 있으면 그 기능(--rpc-url base 별칭, 소스 검증)을 쓸 수 없습니다.
#
# [4] 주소는 EIP-55 체크섬 표기(대소문자 혼합)를 원본에서 그대로 복사하십시오. 대소문자가 섞인 주소의 체크섬이
#     틀리면(한 글자 오타) 스크립트가 중단하고, Base 메인넷(8453)에서는 전부 소문자인 주소(체크섬 정보 없음)도
#     거부합니다. 체크섬 오류가 나면 대소문자만 고치지 말고 원본에서 다시 복사하십시오.
#     예외: 공식 출처가 주소를 전부 소문자로만 공개하는 경우(예: UNCX 락커 문서)는 원래 체크섬 정보가 없으므로
#     cast to-check-sum-address <소문자 주소>로 변환해 써도 됩니다(대소문자가 섞인 값을 손으로 고치는 것과 다름).
#
# [5] 수량 단위가 섞여 있습니다: wei 단위(FIRE·ETH 모두 1개 = 10^18 wei, 정수)와 FIRE 정수 단위.
#     각 항목의 [단위]를 확인하십시오. 정수만 허용하며 "3 ether"·"1e18"·소수점·쉼표 표기는 쓸 수 없습니다.
# ═════════════════════════════════════════════════════════════════════════════════════════════


# ─── 0. RPC · 소스 검증 (foundry.toml이 읽음) ───────────────────────────────────────────────

# Base 메인넷(8453) RPC URL. --rpc-url base 별칭과 메인넷 포크 테스트가 사용.
#   공개 RPC는 요청 수 제한이 있으므로 메인넷 런칭에는 전용 RPC를 권장 (API 키가 들어간 URL은 비밀 값으로 취급).
#   비우면: --rpc-url base 사용 불가, 메인넷 포크 테스트는 건너뜀(skip).
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia(84532) RPC URL. --rpc-url base_sepolia 별칭과 Sepolia 포크 테스트가 사용. 비우면 위와 같음.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Etherscan API V2 키 (키 하나로 Base·Base Sepolia 모두 사용). --verify / forge verify-contract에서만 필요.
#   비우면: 소스 검증 단계만 실패 (배포·테스트에는 영향 없음).
ETHERSCAN_API_KEY=


# ─── 1. 런칭 배포: script/Deploy.s.sol ──────────────────────────────────────────────────────
# FireVesting → FireToken 배포 + 트레저리·에어드롭 각 5,000만 FIRE 전송 (트랜잭션 4건).
#   서명 메시지 출력: forge script script/Deploy.s.sol:Deploy --sig "printProofMessages()" --rpc-url <base_sepolia|base>
#   시뮬레이션:       forge script script/Deploy.s.sol:Deploy --rpc-url base_sepolia --ledger --sender <배포 지갑>
#   전송:             위 명령 + --broadcast --slow
#   메인넷(--rpc-url base)은 시뮬레이션·전송 모두 명령 앞에 CONFIRM_MAINNET=I_UNDERSTAND (없으면 시뮬레이션도 중단)
#   기록 확정:        forge script script/Deploy.s.sol:Deploy --sig "confirm()" --rpc-url <별칭>  (환경 변수 불필요)
# 배포 지갑은 코드가 없는 새 하드웨어 지갑 EOA여야 함: EIP-7702 위임 EOA면 8453에서 중단, 테스트넷은 경고.
# 아래 세 주소는 PostDeployCheck도 읽습니다 (설정하면 deployments 기록 대신 이 값과 대조, 다르면 NOTE 출력).

# [필수, 주소] 베스팅 수령 지갑 = FireVesting.owner(). 하드웨어 지갑 주소 또는 Base에 배포된 Safe 권장.
#   생성자에 넣은 주소는 수락 절차 없이 곧바로 owner가 되므로 오타·통제하지 않는 주소면 2억 FIRE가 영구히 묶임.
#   EOA·EIP-7702 위임 EOA면 그 키의 소유 증명 서명, Safe면 그 Safe 소유자들의 서명(임계값 이상)이 필요하고,
#   8453에서는 모듈이 활성화된 Safe와 Safe가 아닌 컨트랙트 주소를 거부함(테스트넷은 경고).
#   비우면 중단. 세 주소(BENEFICIARY·TREASURY_SAFE·AIRDROP_WALLET)는 서로 달라야 하고 배포 지갑과도 달라야 함.
#   자세한 절차와 오류별 조치: deployments/README.md "배포 전 소유 증명".
BENEFICIARY=

# [8453: 필수 / 84532: 넣으면 검증, 비우면 경고 / 31337: 생략]
#   [형식] 0x + 16진수 130자 × 서명 수 (서명 1개 = 65바이트 personal_sign(EIP-191), 최대 16개).
#   아래 한 줄 메시지(주소는 EIP-55 표기, 체인 ID는 10진수)에 대한 서명입니다:
#     FIRE launch control proof | role=BENEFICIARY | address=<BENEFICIARY> | chainId=<8453 또는 84532>
#   - BENEFICIARY가 EOA·EIP-7702 위임 EOA: 그 지갑의 키로 서명한 값 1개.
#   - BENEFICIARY가 Safe: 같은 메시지(address = Safe 주소)에 Safe 소유자들이 각자 자기 키로 서명하고, 서명들을 0x 하나
#     뒤에 이어 붙임(서로 다른 현재 소유자 서명 ≥ 임계값, 순서 무관). 예: 0x<서명1의 130자><서명2의 130자>
#     다른 사람이 만든 비슷한 주소의 Safe는 소유자가 달라 통과할 수 없음 (printProofMessages가 소유자 목록 출력).
#   서명: cast wallet sign --ledger "<위 메시지>"   (키스토어: cast wallet sign --account <이름> "<위 메시지>")
#   확인: cast wallet verify --address <서명한 주소> "<위 메시지>" <서명>
#   체인 ID가 메시지에 들어 있으므로 리허설(84532) 서명은 메인넷에서 통과하지 못함. 형식이 틀리면 모든 체인에서 중단.
#   서명은 비밀 값이 아니지만(공개되어도 자금 위험 없음) 체인별로 새로 만들어야 합니다.
BENEFICIARY_PROOF_SIG=

# [필수, 주소] CEX 상장·MM 트레저리 Safe 멀티시그 (5,000만 FIRE).
#   8453: Base에 배포된 Safe여야 하고 임계값 2 이상·소유자 3명 이상·활성화된 모듈 없음 (모듈은 소유자 서명 없이
#   자산을 옮길 수 있음). EOA·EIP-7702 위임 EOA 거부. 84532·31337: 리허설용으로 EOA·약한 Safe 허용(경고). 비우면 중단.
TREASURY_SAFE=

# [필수, 주소] 에어드롭 전용 지갑 (5,000만 FIRE = 1차 2,000만 + 2차 3,000만). DeployAirdrop의 브로드캐스터가 됨.
#   EOA(하드웨어 지갑) 권장: DeployAirdrop.s.sol은 이 지갑이 직접 서명·전송해야 함 (Safe면 분배 컨트랙트 배포·예치를
#   Safe 트랜잭션으로 따로 해야 함). 소유 증명은 BENEFICIARY와 같은 규칙(EOA는 그 키, Safe는 소유자들의 서명).
#   DeployAirdrop도 이 변수를 읽음(4절, 8453에서는 기록의 wallets.airdropWallet과 같아야 함). 비우면 Deploy 중단.
AIRDROP_WALLET=

# [8453: 필수 / 84532: 넣으면 검증, 비우면 경고 / 31337: 생략]
#   BENEFICIARY_PROOF_SIG와 같은 형식·방법(Safe면 소유자 서명을 이어 붙임)이며 메시지의 role만 다릅니다:
#     FIRE launch control proof | role=AIRDROP_WALLET | address=<AIRDROP_WALLET> | chainId=<8453 또는 84532>
AIRDROP_WALLET_PROOF_SIG=


# ─── 2. 풀 생성: script/CreatePool.s.sol ────────────────────────────────────────────────────
# NPM.multicall{value: SEED_ETH}([permit, createAndInitializePoolIfNecessary, mint, refundETH]) + approve(NPM, 0).
#   시뮬레이션: forge script script/CreatePool.s.sol:CreatePool --rpc-url <별칭> --ledger --sender <배포 지갑>
#   전송:       위 명령 + --broadcast --slow   (메인넷은 시뮬레이션·전송 모두 앞에 CONFIRM_MAINNET=I_UNDERSTAND)
#   기록 확정:  forge script script/CreatePool.s.sol:CreatePool --sig "confirm()" --rpc-url <별칭>
#   락업 확정:  LP_LOCKER=<락커> forge script script/CreatePool.s.sol:CreatePool --sig "confirmLock()" --rpc-url <별칭>
#               (LP NFT를 락커에 맡긴 직후. UNCX는 락업 때 LP 유동성의 일부를 수수료로 가져가므로 락업 후 유동성을
#                PostDeployCheck의 비교 기준으로 기록함. 이 단계 없이는 PostDeployCheck가 "유동성 감소" FAIL)
# 8453: Deploy가 쓴 deployments/8453.json(deployer·deployerNonce 포함)이 반드시 있어야 하고, 토큰은 브로드캐스터(배포
#   지갑)가 직접 만든 CREATE 주소여야 함. 브로드캐스터에 코드가 있으면(EIP-7702 위임) 중단. 테스트넷은 경고만.

# [선택, 주소] FireToken 주소. 비우면 deployments/<chainId>.json의 contracts.FireToken (권장: 비워 두기).
#   둘 다 있는데 서로 다르면 모든 스크립트(CreatePool·PostDeployCheck·DeployAirdrop·DeployBatchSender)가 중단.
#   8453에서 CreatePool·DeployAirdrop·DeployBatchSender는 Deploy 기록이 반드시 있어야 함(FIRE_TOKEN만으로 실행 불가:
#   이름·바이트코드가 같은 복제 토큰으로 주소를 오염시키는 공격 방지). 기록이 없는 테스트넷·로컬에서는 필요.
FIRE_TOKEN=

# [선택, 단위: wei] 풀에 넣을 ETH. 비우면 3 ETH = 3000000000000000000.
#   하한: 8453은 1 ETH(10^18) 이상, 테스트넷은 0.001 ETH(10^15) 이상 (ETH 단위로 "3"을 넣는 실수 차단).
#   배포 지갑에는 시딩 ETH 외에 가스·락커 수수료용 여유분(약 0.15 ETH)을 둘 것 (가이드 2.3절).
SEED_ETH=

# [선택, 단위: wei(FIRE)] 풀에 넣을 FIRE. 비우면 7억 FIRE = 700000000000000000000000000.
#   8453에서는 정확히 7억 FIRE만 허용. 테스트넷 리허설은 1 FIRE(10^18) 이상.
LP_FIRE_AMOUNT=

# [선택] Uniswap V3 수수료 등급. 비우면 10000(1%). 다른 값은 3000(0.3%)만 허용.
#   선점된 풀이 있어 중단되면 다른 등급으로 다시 실행 (deployments/README.md "풀 선점 방지와 대응").
FEE_TIER=

# [선택, 단위: bp(0.01%)] mint 최소 수량 슬리피지. 비우면 50(0.5%). 허용 1~100.
SLIPPAGE_BPS=

# [선택, 단위: unix 초] 미리 서명한 permit의 마감 시각. PERMIT_SIGNATURE를 넣으면 필수(없으면 중단).
#   permitTypedData()가 출력한 값을 그대로 사용. 비우면 permitTypedData()는 현재 + 1시간으로 계산.
PERMIT_DEADLINE=

# [선택, 형식: 0x + 65바이트 서명] 하드웨어 지갑으로 미리 서명한 EIP-2612 permit (spender = Uniswap NPM, 수량 = LP_FIRE_AMOUNT).
#   1) forge script script/CreatePool.s.sol:CreatePool --sig "permitTypedData()" --rpc-url <별칭> --sender <배포 지갑>
#   2) cast wallet sign --ledger --data --from-file deployments/permit-<chainId>.json
#   3) PERMIT_DEADLINE·PERMIT_SIGNATURE를 export하고 CreatePool --broadcast (마감까지 5분 이상 남아 있어야 함)
#   서명자는 브로드캐스터와 같아야 함. 비우면: --account 키스토어는 스크립트가 직접 permit 서명, --ledger는 별도
#   approve 트랜잭션으로 대체(경고 출력). 한 번 쓰면 nonce가 바뀌어 재사용할 수 없으므로 사용 후 지우십시오.
PERMIT_SIGNATURE=

# [선택, 정수] LP 포지션 NFT id. CreatePool confirm()과 PostDeployCheck가 읽음.
#   비우면(0) 배포 지갑이 보유한 NFT(가장 오래된 100개)에서 런칭 크기의 FIRE/WETH 전체 범위 포지션을 찾음. 이미 락커로
#   옮겨 배포 지갑에 NFT가 없거나, 런칭 전에 받은 NFT가 100개를 넘어 confirm()이 CreatePoolPositionNotFound로 멈추면
#   지정하십시오(id는 CreatePool multicall의 IncreaseLiquidity 이벤트). 지정한 id도 온체인에서 FIRE/WETH 전체 범위
#   포지션이고 기록된 계획(투입량·슬리피지)의 런칭 크기 이상인지 다시 확인함 (누구나 배포 지갑으로 보낼 수 있는 소액
#   포지션은 거부).
LP_TOKEN_ID=


# ─── 3. 배포 후 점검: script/PostDeployCheck.s.sol (읽기 전용, 서명·전송 없음) ─────────────
# deployments/<chainId>.json을 읽고, 아래 변수와 1·2절의 FIRE_TOKEN·BENEFICIARY·TREASURY_SAFE·AIRDROP_WALLET·
# LP_TOKEN_ID가 설정돼 있으면 그 값이 기록보다 우선합니다 (기록과 다르면 NOTE 출력). 모두 선택이며 비우면 기록값.
#   forge script script/PostDeployCheck.s.sol:PostDeployCheck --rpc-url <별칭>

# [선택, 주소] FireVesting 주소. 비우면 기록의 contracts.FireVesting.
FIRE_VESTING=

# [선택, 주소] 배포 지갑 주소 (LP 포지션 탐색·잔액 점검). 비우면 기록의 deployer.
DEPLOYER=

# [선택, 주소] LP NFT를 보관하는 락커 컨트랙트(UNCX / Team Finance). CreatePool confirmLock()과 PostDeployCheck가 읽음.
#   confirmLock(): 지정하면 NFT 보유자가 이 주소인지 확인한 뒤 기록의 lpLock.locker에 씀.
#   PostDeployCheck: 지정하면 NFT 보유자가 이 주소인지 PASS/FAIL로 판정. 비우면 기록의 lpLock.locker. 그것도 없으면
#   보유자에 따라 WARN만 표시 (배포 지갑 = 아직 락업 안 됨, 컨트랙트 = 락커인지 확인 필요, 그 밖의 EOA = 락커 아님).
LP_LOCKER=


# ─── 4. 에어드롭 회차 배포: script/DeployAirdrop.s.sol ─────────────────────────────────────
# 브로드캐스터 = 에어드롭 전용 지갑(AIRDROP_WALLET). 회차마다 FireMerkleDistributor 배포 + merkle.json total만큼 예치.
#   시뮬레이션: forge script script/DeployAirdrop.s.sol:DeployAirdrop --rpc-url <별칭> --ledger --sender <AIRDROP_WALLET>
#   전송:       위 명령 + --broadcast --slow   (메인넷은 시뮬레이션·전송 모두 앞에 CONFIRM_MAINNET=I_UNDERSTAND)
# FIRE_TOKEN(비우면 기록값)과 AIRDROP_WALLET(8453 필수, 설정하면 모든 체인에서 브로드캐스터와 같아야 함)은 위 절의 값.
# 8453: deployments/8453.json(Deploy 기록) 필수, FIRE_TOKEN·AIRDROP_WALLET이 기록과 같아야 함.
# 자세한 절차: airdrop/README.md

# [필수, 경로] airdrop/generate.mjs가 만든 merkle.json (프로젝트 루트 기준). foundry.toml fs_permissions상
#   airdrop/out/ 또는 test/fixtures/ 아래만 읽을 수 있음. 예: airdrop/out/round-1/merkle.json
#   test/fixtures/airdrop-sample.json(샘플)은 메인넷에서 내용(root)으로 거부됨.
AIRDROP_MERKLE_JSON=

# [8453 필수, bytes32] GitHub에 먼저 공개한 Merkle Root (0x + 16진수 64자). 설정하면 merkle.json의 root와 같아야 함.
AIRDROP_EXPECTED_ROOT=

# [선택, 단위: 일] 클레임 기간. 비우면 90. 허용 1~365 (마감 = 시뮬레이션 블록 시각 + 일수 × 86400).
AIRDROP_CLAIM_DAYS=

# [선택, 주소] 마감 후 sweep()으로 미청구 FIRE를 회수할 주소. 비우면 브로드캐스터(에어드롭 지갑, 권장).
#   배포 후 바꿀 수 없음(immutable). FIRE 토큰 주소는 거부. 브로드캐스터와 다르면 경고 출력.
AIRDROP_SWEEP_RECIPIENT=


# ─── 5. Batch Sender 배포: script/DeployBatchSender.s.sol (로드맵 2027 Q1) ─────────────────
# 배포자는 아무 권한도 갖지 않으며 수수료 설정 권한(owner)은 생성자에서 곧바로 지정됨.
#   forge script script/DeployBatchSender.s.sol:DeployBatchSender --rpc-url <별칭> --ledger --sender <배포자> --broadcast --slow --verify
#   (트랜잭션 1건이지만 다른 스크립트와 같이 --slow. 메인넷은 시뮬레이션·전송 모두 앞에 CONFIRM_MAINNET=I_UNDERSTAND)
# FIRE_TOKEN(선택)은 2절의 값: 비우면 기록값, 8453은 Deploy 기록(deployments/8453.json)이 반드시 있어야 하고 그 값과 같아야 함.

# [선택, 주소] 수수료 설정 권한자 = 트레저리 Safe. 비우면 기록의 wallets.treasurySafe.
#   8453: 기록된 트레저리와 같아야 하고 임계값 2 이상·소유자 3명 이상·모듈 없는 Safe (EOA·EIP-7702 위임 EOA 거부).
#   84532·31337: 리허설용으로 EOA·기록과 다른 주소 허용(경고). 소유권 포기(renounce)는 컨트랙트가 막음.
BATCH_SENDER_OWNER=

# [선택, 정수(명)] 수수료 없이 보낼 수 있는 최대 수령자 수. 비우면 25. 허용 0~300 (0이면 모든 배치 유료).
BATCH_FREE_RECIPIENTS=

# [선택, 단위: FIRE 정수 (wei 아님)] 유료 배치 1회당 소각 수수료. 비우면 10000(= 1만 FIRE).
#   스크립트가 × 10^18 해서 burnFee(wei)로 설정. 허용 0~1000000 (MAX_BURN_FEE = 100만 FIRE).
BATCH_BURN_FEE_FIRE=


# ─── 6. 메인넷 확인 문구 (Deploy · CreatePool · DeployAirdrop · DeployBatchSender) ─────────
# Base 메인넷(8453)에서 트랜잭션을 만드는 스크립트는 CONFIRM_MAINNET이 정확히 I_UNDERSTAND일 때만 진행합니다.
# 전송 플래그가 없는 시뮬레이션도 같은 확인을 거치므로 메인넷 시뮬레이션에도 붙여야 합니다(없으면 중단, 전송 없음).
# .env에 넣으면 이후 모든 실행에서 확인이 생략되므로 넣지 말고, 메인넷 명령 한 번에만 앞에 붙이십시오:
#   CONFIRM_MAINNET=I_UNDERSTAND forge script ... --rpc-url base --ledger --sender <주소> [--broadcast --slow]
# 또한 forge script에 --chain / --chain-id 나 FOUNDRY_CHAIN_ID를 주지 마십시오(시뮬레이션 체인만 바뀌어 메인넷
# 가드를 우회할 수 있음). 스크립트는 RPC의 eth_chainId와 대조해 다르면 중단합니다. --rpc-url만 사용하십시오.
# CONFIRM_MAINNET=I_UNDERSTAND


# ─── 7. 테스트 전용 (forge test) ────────────────────────────────────────────────────────────

# [선택, 블록 번호] Base 메인넷 포크 테스트의 포크 블록. 비우면 테스트에 고정된 블록(재현성·RPC 캐시),
#   0이면 최신 블록. BASE_RPC_URL이 비어 있으면 포크 테스트 자체를 건너뜀.
BASE_FORK_BLOCK=

# [선택, 블록 번호] Base Sepolia 포크 테스트의 포크 블록. 비우면 고정 블록, 0이면 최신 블록.
BASE_SEPOLIA_FORK_BLOCK=
