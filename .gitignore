# Compiler files (루트 디렉터리만. airdrop/out 등 하위 out/은 커밋 대상)
/cache/
/out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example

# Airdrop tooling
airdrop/node_modules/

# 배포 보조 임시 파일 (커밋 금지)
# - permit 서명 요청 데이터: CreatePool 실행 후 삭제하는 임시 파일
# - 테스트가 중간 실패 시 남길 수 있는 임시 기록
# - 로컬 anvil(31337) 실험 기록 (공개 기록은 8453.json·84532.json만)
/deployments/permit-*.json
/deployments/test-*.json
/deployments/31337.json

# forge coverage --report lcov 결과 (CI 아티팩트로만 보관)
/lcov.info
